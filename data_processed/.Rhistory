# Bekijk de data of de gen namen op kolommen staan
colnames(resultaten_RA)
# Maak een vector voor de genen, nu wordt gekeken welke wel significant zijn (1 vs 0)
gene.vector <- as.integer(resultaten_RA$padj < 0.05)
