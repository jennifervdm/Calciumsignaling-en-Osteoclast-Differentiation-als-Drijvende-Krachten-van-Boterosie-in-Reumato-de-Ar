library(ANCOMBC)
#
#
#
#
#
#
#?s
ancom.out <- ancombc2(data = ps,
tax_level = "Genus",
p_adj_method = "bonferroni",
fix_formula = "case_control",
alpha = 0.05)
BiocManager::install("microbiome")
library(ANCOMBC)
# Voer een statistische toets uit
# Data = dataset, tax_level = kleinste tax niveau die analyseren, bvb genus/species/fyla
# P_adj_method = significantie met bonferroni correctie, fix_formula = groepen, alpha = range
ancom.out <- ancombc2(data = ps,
tax_level = "Genus",
p_adj_method = "bonferroni",
fix_formula = "case_control",
alpha = 0.05)
# Kijken hoe ancom.out eruitziet. Daar staat best veel in!
head(ancom.out)
head(ancom.out)
# ancom.out bestaat uit meerdere onderdelen die je met een $ kan zien.
# De resultaten opslaan in results.
results <- ancom.out$res
#
head(results$p_case_controlControl)
head(results$q_case_controlControl)
# Tabel maken
ancom.res <- data.frame(Taxa = results$taxon,
LogFC = results$lfc_case_controlControl,
p_value = ...,
q_value = ...,
SE = ...)
# Tabel bekijken
head(ancom.res)
# Tabel maken
ancom.res <- data.frame(Taxa = results$taxon,
LogFC = results$lfc_case_controlControl,
p_value = results$p_case_controlControl,
q_value = results$q_case_controlControl,
SE = results$se_case_controlControl)
# Tabel bekijken
head(ancom.res)
# Significante resultaten visualiseren
# Significante bacteriën selecteren
sig.res <- filter(ancom.res, q_value < 0.05)
# Selectie bekijken
head(sig.res)
# Maak een figuur van alle taxa
ggplot(sig.res, aes(x = Taxa, y = LogFC)) +
geom_bar(stat = "identity")
# Je kan de bacterienamen niet zien, dus draai ze een kwartslag
ggplot(sig.res, aes(x = Taxa, y = LogFC, fill)) +
geom_bar(stat = "identity") +
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust=1))
# Normaal is het beter om de namen tot de genus namen in te korten
# Voeg foutbalken toe
ggplot(sig.res, aes(x = Taxa, y = LogFC)) +
geom_bar(stat = "identity") +
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust=1)) +
geom_errorbar(aes(ymin = LogFC - SE, ymax = LogFC + SE), width = 0.2)
# Geef de staven een andere kleur voor extra swag
ggplot(sig.res, aes(x = Taxa, y = LogFC, fill = LogFC < 0)) +
geom_bar(stat = "identity") +
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust=1)) +
geom_errorbar(aes(ymin = LogFC - SE, ymax = LogFC + SE), width = 0.2) +
scale_fill_manual("Negative LogFC", values = c("darkolivegreen3", "salmon2"))
# Sla het op zodat het in Excel geopend kan worden
write.csv2(ancom.res, "C:/Users/Jenni/OneDrive - NHL Stenden/j2/p4/metagenomics/werkcolleges/werkcollege-4_abundantie-analyse/differentiele-abundantie-analyse.csv", row.names = FALSE)
# Of zo al je een ander format gebruikt in Excel
write.csv(ancom.res, "C:/Users/Jenni/OneDrive - NHL Stenden/j2/p4/metagenomics/werkcolleges/werkcollege-4_abundantie-analyse/differentiele-abundantie-analyse.csv", row.names = FALSE)
# Of zo al je een ander format gebruikt in Excel
write.csv(ancom.res, "C:/Users/Jenni/OneDrive - NHL Stenden/j2/p4/metagenomics/werkcolleges/werkcollege-4_abundantie-analyse/differentiele-abundantie-analyse.csv", row.names = FALSE)
# Sla het op zodat het in Excel geopend kan worden
